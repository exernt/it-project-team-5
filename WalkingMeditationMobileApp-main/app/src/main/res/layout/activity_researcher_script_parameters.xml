<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/script_parameters_title"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/scriptParametersText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_24"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="@string/script_parameters_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="10000"
        android:minLines="8"
        android:padding="@dimen/field_padding"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btnScriptParametersConfirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/field_height"
        android:layout_marginTop="@dimen/space_24"
        android:backgroundTint="@color/sky_blue_dark"
        android:text="@string/confirm"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnScriptParametersCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/field_height"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:text="@string/cancel" />

</LinearLayout>
