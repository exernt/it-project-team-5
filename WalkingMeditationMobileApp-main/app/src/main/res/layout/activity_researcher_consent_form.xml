<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/screen_padding_horizontal">

    <ProgressBar
        android:id="@+id/consentEditorProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/consentEditorContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/consentEditorLockedNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/consent_editor_locked_notice"
                android:textColor="@color/hint_grey"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/consent_form_heading"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/consentEditorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/rounded_description_box"
                android:gravity="top"
                android:hint="@string/consent_editor_hint"
                android:inputType="textMultiLine"
                android:minLines="10"
                android:padding="@dimen/field_padding"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/consentEditorVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:gravity="start"
                android:textColor="@color/hint_grey"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConsentEditorSave"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="@dimen/space_24"
                android:backgroundTint="@color/sky_blue_dark"
                android:text="@string/consent_editor_save"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnConsentEditorBack"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/back" />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/consentEditorMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/hint_grey"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
