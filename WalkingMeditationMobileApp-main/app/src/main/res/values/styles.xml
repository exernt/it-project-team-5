<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="App" parent="Theme.Material3.DayNight.NoActionBar"/>

    <!-- Label style: "Source" / "Destination" -->
    <style name="App.Label">
        <item name="android:textColor">@color/sky_blue_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_8</item>
    </style>

    <!-- Rounded input style for EditText/AutoCompleteTextView -->
    <style name="App.RoundedInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:background">@drawable/rounded_input</item>
        <item name="android:padding">@dimen/field_padding</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/hint_grey</item>
    </style>

    <!-- Primary rounded button -->
    <style name="App.PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:background">@drawable/rounded_button</item>

        <!-- keep these because your XML uses them -->
        <item name="android:backgroundTint">@null</item>
        <item name="android:backgroundTintMode">add</item>

        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Screen container padding/alignment -->
    <style name="App.ScreenContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">@dimen/screen_padding_top</item>
        <item name="android:paddingLeft">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/screen_padding_horizontal</item>
    </style>

</resources>