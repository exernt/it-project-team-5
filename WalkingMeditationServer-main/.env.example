GOOGLE_MAPS_API_KEY=
ENABLE_PARK_FALLBACK=false
OPENAI_API_KEY=
APP_API_TOKEN=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POSTGRES_DB=walking_meditation
POSTGRES_USER=walking_app
POSTGRES_PASSWORD=walking_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://walking_app:walking_local@localhost:5432/walking_meditation
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
ENABLE_NEARBY_CONTEXT=false
SCRIPT_FALLBACK_ENABLED=true
EMAIL_BACKEND=file
EMAIL_CAPTURE_DIRECTORY=var/dev-mail
PASSWORD_RESET_FROM_EMAIL=Walking Meditation <no-reply@localhost>
PASSWORD_RESET_REPLY_TO_EMAIL=
PASSWORD_RESET_LINK_BASE=walkingmeditation://password-reset
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
SES_CONFIGURATION_SET=
ANDROID_APP_PACKAGE_NAME=com.example.walking_meditation
